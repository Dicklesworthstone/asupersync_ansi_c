# .clang-tidy — Static analysis configuration for asupersync_ansi_c
#
# C99 project — all C++-specific checks disabled.
# Triage: ran full check suite on all src/*.c, categorized findings,
# disabled checks producing >10 false positives with <2 real bugs.
#
# SPDX-License-Identifier: MIT

Checks: >
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  readability-implicit-bool-conversion,
  -bugprone-easily-swappable-parameters,
  -bugprone-assignment-in-if-condition,
  -cert-dcl37-c,
  -cert-dcl51-cpp,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -misc-include-cleaner,
  -cert-err33-c

# Only check project headers, not system headers
HeaderFilterRegex: 'include/asx/.*'

# Treat critical checks as errors
WarningsAsErrors: >
  clang-analyzer-core.NullDereference,
  clang-analyzer-core.UndefinedBinaryOperatorResult,
  clang-analyzer-unix.Malloc

# Check options
CheckOptions:
  - key:   readability-implicit-bool-conversion.AllowPointerConditions
    value: true
  - key:   readability-implicit-bool-conversion.AllowIntegerConditions
    value: true

# Rationale for disabled checks:
#
# bugprone-easily-swappable-parameters:
#   Too noisy for callback-heavy C API where most functions take
#   (id, status) pairs that are typedef'd integers.
#
# bugprone-assignment-in-if-condition:
#   Project uses intentional `if ((st = func()) != OK)` patterns.
#
# cert-dcl37-c / cert-dcl51-cpp:
#   Flags identifiers starting with underscore — false positive on
#   _sbrk and other libc-mandated names in bare-metal stubs.
#
# clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling:
#   Flags memcpy/memset which are fundamental in zero-alloc C99.
#   The project does not use user-controlled sizes unsafely.
#
# misc-include-cleaner:
#   Flags transitive includes as missing direct includes. This project
#   uses umbrella headers (asx.h) and internal headers that provide all
#   needed types transitively. Adding redundant direct includes would
#   clutter source files without improving correctness.
#
# cert-err33-c:
#   Flags unchecked return values on internal helper functions (memset,
#   snprintf in bounded buffers, arena reset). These are intentionally
#   fire-and-forget calls where the return value is meaningless or
#   the buffer is statically bounded.
