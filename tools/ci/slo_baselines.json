  "governance": {
    "update_policy": "Baseline changes require explicit rationale in commit message and must reference the benchmark run that justifies the new values. Use 'make bench-json > bench-results.json' for normal profiles and 'rch exec -- make parallel-bench-json > parallel-bench-results.json' for PARALLEL worker-count baselines.",
    "tolerance_policy": "Each metric budget is set to baseline_value * headroom_multiplier. The multiplier accounts for CI runner variance, OS scheduling jitter, and measurement noise. Tighter multipliers are used for low-variance operations (e.g., timer_cancel) and looser for high-variance ones (e.g., timer_register).",
    "approval_required": true,
    "audit_trail": [
      {
        "date": "2026-03-01",
        "author": "FoggyForge",
        "action": "initial_capture",
        "rationale": "First SLO baseline from CORE profile bench run on development host. p99 budgets use 5x headroom; p99.9/p99.99 use 10-50x headroom due to extreme tail volatility on shared/CI hosts. Fast operations (timer_cancel, channel_recv) get extra headroom since OS noise dominates their baseline.",
        "commit": "07b193833509ff496ed1e02201baa06dab1e53be"
      },
      {
        "date": "2026-03-02",
        "author": "SandyAnchor",
        "action": "add_hft_profile",
        "rationale": "HFT profile baselines from development host. Captures HFT-specific instrumentation overhead. Same headroom strategy as CORE. Closes quality gate gap bd-39o.",
        "commit": "pending"
      },
      {
        "date": "2026-05-08",
        "author": "SilverFrog",
        "action": "add_parallel_observe_only_profile",
        "rationale": "PARALLEL profile gross-regression baseline from rch exec -- make parallel-bench-json on worker vmi1149989. Worker-count baselines stay in the benchmark artifact; SLO profile keeps loose thresholds for the aggregate large-swarm lane.",
        "commit": "pending"
      },
      {
        "date": "2026-05-08",
        "author": "SilverFrog",
        "action": "calibrate_parallel_overload_admission_slos",
        "rationale": "RCH run `rch exec -- make parallel-bench-gate` on worker vmi1152480 emitted 5 worker-count rows and 15 resource-class footprint rows. Expected full-queue pressure produced observe-only warnings for worker_count=1/2/8/32/64; block count stayed 0. Thresholds are resource-plane gates only and require profile-parity evidence before any baseline update can claim semantic safety.",
        "commit": "pending"
      }
    ]
