{"schema":"asx.scenario.v2","id":"mpsc-counted-senders-close-at-last-drop-001","description":"An mpsc with two senders (t.a and the clone t.b). t.a sends 1 and drops its sender; the channel stays open, so t.b, waking later, still sends 2 and ends, dropping the last sender. The receiver gets 1 and 2 and only then sees the channel disconnected (Rust Sender::clone/drop, mpsc.rs:1231-1255; bd-9kll.5.4).","unit":"mpsc","rules":["inv.determinism.replayable"],"seed":42,"lab":{"max_steps":1000},"regions":[{"name":"r.main","parent":"root","budget":null}],"channels":[{"name":"ch","type":"mpsc","capacity":2,"sender":"t.a","senders":["t.b"],"receiver":"t.r"}],"sync":[],"tasks":[{"name":"t.a","region":"r.main","budget":null,"program":[{"op":"send","channel":"ch","value":1},{"op":"close_sender","channel":"ch"},{"op":"trace","message":"a dropped its sender"}]},{"name":"t.b","region":"r.main","budget":null,"program":[{"op":"sleep","ns":100},{"op":"send","channel":"ch","value":2},{"op":"trace","message":"b sent"}]},{"name":"t.r","region":"r.main","budget":null,"program":[{"op":"recv","channel":"ch"},{"op":"recv","channel":"ch"},{"op":"recv","channel":"ch"},{"op":"trace","message":"r saw the close"}]}],"script":[],"expect":{"kind":"ok"}}
