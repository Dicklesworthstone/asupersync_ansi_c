{
  "schema": "asx.scenario.v2",
  "id": "region-body-closed-exception-001",
  "description": "An empty region closes after an Ok body while a separate root observer has completed. Subsequent Cancelled, Err and Panicked body requests emit Rust's cancellation receipts even for a Closed region, preserving its terminal state and child outcome without another close transition.",
  "unit": "region_lifecycle",
  "rules": ["rule.region.close_begin", "rule.cancel.request", "inv.region.quiescence"],
  "seed": 42,
  "lab": {"max_steps": 1000},
  "regions": [{"name": "r.main", "parent": "root", "budget": null}],
  "channels": [], "sync": [],
  "tasks": [{"name": "t.observer", "region": "root", "budget": null,
    "program": [{"op": "checkpoint"}]}],
  "script": [
    {"at_ns": 0, "op": {"op": "finish_region", "region": "r.main", "body": "ok"}},
    {"at_ns": 0, "op": {"op": "finish_region", "region": "r.main", "body": "cancelled", "kind": "User", "message": "closed body request"}},
    {"at_ns": 0, "op": {"op": "finish_region", "region": "r.main", "body": "err"}},
    {"at_ns": 0, "op": {"op": "finish_region", "region": "r.main", "body": "panicked"}}
  ],
  "expect": {"kind": "ok"}
}
