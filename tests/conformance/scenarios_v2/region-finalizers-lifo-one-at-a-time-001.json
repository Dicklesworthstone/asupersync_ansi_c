{
  "schema": "asx.scenario.v2",
  "id": "region-finalizers-lifo-one-at-a-time-001",
  "description": "Two async finalizers on r.main run once its task is done, the last registered first, each to its end before the next one starts: the lab spawns one masked finalizer task per region per step (drain_ready_async_finalizers, state.rs:8578), so f.second's task completes before f.first's is spawned.",
  "unit": "region_lifecycle",
  "rules": ["rule.region.close_begin", "rule.region.close_children_done", "rule.region.close_complete", "inv.determinism.replayable"],
  "seed": 42,
  "lab": {"max_steps": 1000},
  "regions": [{"name": "r.main", "parent": "root", "budget": null,
    "finalizers": [
      {"name": "f.first", "program": [{"op": "trace", "message": "first start"}, {"op": "yield"}, {"op": "trace", "message": "first end"}]},
      {"name": "f.second", "program": [{"op": "trace", "message": "second start"}, {"op": "yield"}, {"op": "trace", "message": "second end"}]}
    ]}],
  "channels": [], "sync": [],
  "tasks": [{"name": "t.work", "region": "r.main", "budget": null,
    "program": [{"op": "sleep", "ns": 100}, {"op": "trace", "message": "work done"}]}],
  "script": [{"at_ns": 0, "op": {"op": "finish_region", "region": "r.main", "body": "ok"}}],
  "expect": {"kind": "ok"}
}
