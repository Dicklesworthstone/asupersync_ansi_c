{"schema":"asx.scenario.v2","id":"sync-notify-one-wakes-waiters-in-arrival-order-001","description":"Three tasks park on one Notify, arriving at 10, 20 and 30. t.sig then calls notify_one three times, 100 apart: each call wakes exactly one waiter, the longest-parked first (take_next_active_waker, sync/notify.rs), so t.w1 passes at 100, t.w2 at 200 and t.w3 at 300, the others staying parked meanwhile.","unit":"sync","rules":["inv.determinism.replayable"],"seed":42,"lab":{"max_steps":1000},"regions":[{"name":"r.main","parent":"root","budget":null}],"channels":[],"sync":[{"name":"n","type":"notify"}],"tasks":[{"name":"t.w1","region":"r.main","budget":null,"program":[{"op":"sleep","ns":10},{"op":"notify_wait","notify":"n"},{"op":"trace","message":"w1 passed"}]},{"name":"t.w2","region":"r.main","budget":null,"program":[{"op":"sleep","ns":20},{"op":"notify_wait","notify":"n"},{"op":"trace","message":"w2 passed"}]},{"name":"t.w3","region":"r.main","budget":null,"program":[{"op":"sleep","ns":30},{"op":"notify_wait","notify":"n"},{"op":"trace","message":"w3 passed"}]},{"name":"t.sig","region":"r.main","budget":null,"program":[{"op":"sleep","ns":100},{"op":"trace","message":"signal 1"},{"op":"notify_one","notify":"n"},{"op":"sleep","ns":100},{"op":"trace","message":"signal 2"},{"op":"notify_one","notify":"n"},{"op":"sleep","ns":100},{"op":"trace","message":"signal 3"},{"op":"notify_one","notify":"n"}]}],"script":[],"expect":{"kind":"ok"}}
