{"schema":"asx.scenario.v2","id":"watch-sends-coalesce-into-one-change-001","description":"A watch holds only its latest value: t.pub sends 1, 2 and 3 before the subscriber looks. t.sub's changed() then reports one change carrying 3 (the intermediate values are gone), has_changed is false afterwards, and borrow reads 3: three sends make one observable version step for a receiver that was not waiting.","unit":"watch","rules":["inv.determinism.replayable"],"seed":42,"lab":{"max_steps":500},"regions":[{"name":"r.main","parent":"root","budget":null}],"channels":[{"name":"ch.cfg","type":"watch","initial":0,"sender":"t.pub","subscribers":["t.sub"]}],"sync":[],"tasks":[{"name":"t.pub","region":"r.main","budget":null,"program":[{"op":"watch_send","channel":"ch.cfg","value":1},{"op":"watch_send","channel":"ch.cfg","value":2},{"op":"watch_send","channel":"ch.cfg","value":3}]},{"name":"t.sub","region":"r.main","budget":null,"program":[{"op":"sleep","ns":100},{"op":"watch_changed","channel":"ch.cfg"},{"op":"watch_has_changed","channel":"ch.cfg"},{"op":"watch_borrow","channel":"ch.cfg"}]}],"script":[],"expect":{"kind":"ok"}}
