{"schema":"asx.scenario.v2","id":"link-trap-reasons-001","description":"A trapping holder with three links is signalled with each peer's exit as a reason: an err return (a value, so a normal exit), a cancellation by the driver and a panic are awaited as normal, cancelled and panicked, in the order the holder asks.","unit":"task_lifecycle","rules":["inv.determinism.replayable"],"seed":42,"lab":{"max_steps":800},"regions":[{"name":"r.main","parent":"root","budget":null}],"channels":[],"sync":[],"tasks":[{"name":"t.err","region":"r.main","budget":null,"program":[{"op":"sleep","ns":100},{"op":"return","outcome":{"status":"ASX_E_INVALID_STATE","tag":"err"}}]},{"name":"t.cancel","region":"r.main","budget":null,"program":[{"op":"sleep","ns":5000}]},{"name":"t.panic","region":"r.main","budget":null,"program":[{"op":"sleep","ns":100},{"op":"return","outcome":{"message":"boom","tag":"panicked"}}]},{"name":"t.holder","region":"r.main","budget":null,"program":[{"op":"link_trapping","task":"t.err","as":"l.err"},{"op":"link_trapping","task":"t.cancel","as":"l.cancel"},{"op":"link_trapping","task":"t.panic","as":"l.panic"},{"op":"await_exit","link":"l.err"},{"op":"await_exit","link":"l.cancel"},{"op":"await_exit","link":"l.panic"}]}],"script":[{"at_ns":500,"op":{"op":"cancel_task","task":"t.cancel","kind":"User"}}],"expect":{"kind":"ok"}}
