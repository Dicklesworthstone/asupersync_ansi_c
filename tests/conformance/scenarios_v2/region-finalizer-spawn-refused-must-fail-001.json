{
  "schema": "asx.scenario.v2",
  "id": "region-finalizer-spawn-refused-must-fail-001",
  "description": "A finalizer runs in its region's Finalizing state, which refuses ordinary work: its spawn is refused with ASX_E_REGION_CLOSED (SpawnError::RegionClosed, record/region.rs:134-142, Rust commit 59bdc2baa) and its join of the refused child observes the same. The finalizer's own task was admitted as cleanup work and ends normally; the region closes.",
  "unit": "region_lifecycle",
  "rules": ["rule.ownership.spawn", "rule.region.close_begin", "rule.region.close_complete", "inv.determinism.replayable"],
  "seed": 42,
  "lab": {"max_steps": 1000},
  "regions": [{"name": "r.main", "parent": "root", "budget": null,
    "finalizers": [
      {"name": "f.late", "program": [
        {"op": "spawn", "as": "f.late.c1", "program": [{"op": "trace", "message": "never runs"}]},
        {"op": "join", "task": "f.late.c1"},
        {"op": "trace", "message": "finalizer ended"}]}
    ]}],
  "channels": [], "sync": [],
  "tasks": [{"name": "t.work", "region": "r.main", "budget": null,
    "program": [{"op": "sleep", "ns": 100}, {"op": "trace", "message": "work done"}]}],
  "script": [{"at_ns": 0, "op": {"op": "finish_region", "region": "r.main", "body": "ok"}}],
  "expect": {"kind": "must_fail", "error": {"task": "f.late", "step": 1, "status": "ASX_E_REGION_CLOSED"}}
}
