{"schema":"asx.scenario.v2","id":"sync-rwlock-poisoned-by-panic-001","description":"t.r takes a read lock on l and panics while holding it, which does not poison l; t.w then takes the write lock and panics while holding it, which does; t.b, queued for a read, and t.c, which asks for the write lock after t.w ended, both fail with Poisoned.","unit":"sync","rules":["def.outcome.four_valued"],"seed":42,"lab":{"max_steps":1000},"regions":[{"name":"r.main","parent":"root","budget":null}],"channels":[],"sync":[{"name":"l","type":"rwlock"}],"tasks":[{"name":"t.r","region":"r.main","budget":null,"program":[{"op":"rwlock_read","rwlock":"l"},{"op":"return","outcome":{"tag":"panicked","message":"reader boom"}}]},{"name":"t.w","region":"r.main","budget":null,"program":[{"op":"sleep","ns":50},{"op":"rwlock_write","rwlock":"l"},{"op":"sleep","ns":100},{"op":"return","outcome":{"tag":"panicked","message":"writer boom"}}]},{"name":"t.b","region":"r.main","budget":null,"program":[{"op":"sleep","ns":80},{"op":"rwlock_read","rwlock":"l"},{"op":"trace","message":"b after read"}]},{"name":"t.c","region":"r.main","budget":null,"program":[{"op":"sleep","ns":300},{"op":"rwlock_write","rwlock":"l"},{"op":"trace","message":"c after write"}]}],"script":[],"expect":{"kind":"ok"}}
