{"schema":"asx.scenario.v2","id":"obligation-every-kind-resolutions-001","description":"One obligation of each of the six kinds, resolved in a mix: SendPermit committed, Ack aborted with Cancel, Lease aborted with Error, IoOp aborted with Explicit, SemaphorePermit committed, Transaction aborted with Cancel. The snapshot records each kind's own final state and abort reason, so a resolution that depended on the kind would show; none leaks.","unit":"obligation","rules":["rule.obligation.reserve","rule.obligation.commit","rule.obligation.abort","inv.obligation.linear"],"seed":42,"lab":{"max_steps":1000},"regions":[{"name":"r.main","parent":"root","budget":null}],"channels":[],"sync":[],"tasks":[{"name":"t.a","region":"r.main","budget":null,"program":[{"op":"reserve","kind":"SendPermit","as":"o.send"},{"op":"reserve","kind":"Ack","as":"o.ack"},{"op":"reserve","kind":"Lease","as":"o.lease"},{"op":"reserve","kind":"IoOp","as":"o.io"},{"op":"reserve","kind":"SemaphorePermit","as":"o.sem"},{"op":"reserve","kind":"Transaction","as":"o.txn"},{"op":"commit","obligation":"o.send"},{"op":"abort","obligation":"o.ack","reason":"Cancel"},{"op":"abort","obligation":"o.lease","reason":"Error"},{"op":"abort","obligation":"o.io","reason":"Explicit"},{"op":"commit","obligation":"o.sem"},{"op":"abort","obligation":"o.txn","reason":"Cancel"}]}],"script":[],"expect":{"kind":"ok"}}
