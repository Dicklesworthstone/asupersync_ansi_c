{"schema":"asx.scenario.v2","id":"monitor-down-reasons-001","description":"A DOWN carries the monitored task's outcome as a reason: an error return, a cancellation by the driver and a panic are awaited as error, cancelled and panicked, in the order the watcher asks, with references 1, 2 and 3 in request order.","unit":"task_lifecycle","rules":["inv.determinism.replayable"],"seed":42,"lab":{"max_steps":800},"regions":[{"name":"r.main","parent":"root","budget":null}],"channels":[],"sync":[],"tasks":[{"name":"t.err","region":"r.main","budget":null,"program":[{"op":"sleep","ns":100},{"op":"return","outcome":{"status":"ASX_E_INVALID_STATE","tag":"err"}}]},{"name":"t.cancel","region":"r.main","budget":null,"program":[{"op":"sleep","ns":5000}]},{"name":"t.panic","region":"r.main","budget":null,"program":[{"op":"sleep","ns":100},{"op":"return","outcome":{"message":"boom","tag":"panicked"}}]},{"name":"t.watcher","region":"r.main","budget":null,"program":[{"op":"monitor","task":"t.err","as":"m.err"},{"op":"monitor","task":"t.cancel","as":"m.cancel"},{"op":"monitor","task":"t.panic","as":"m.panic"},{"op":"await_down","monitor":"m.err"},{"op":"await_down","monitor":"m.cancel"},{"op":"await_down","monitor":"m.panic"}]}],"script":[{"at_ns":500,"op":{"op":"cancel_task","task":"t.cancel","kind":"User"}}],"expect":{"kind":"ok"}}
