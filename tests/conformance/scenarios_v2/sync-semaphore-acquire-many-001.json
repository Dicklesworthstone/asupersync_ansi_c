{"schema":"asx.scenario.v2","id":"sync-semaphore-acquire-many-001","description":"A 3-permit semaphore: t.a takes 2 and holds them across a sleep; t.b asks for 2 and waits (1 free); t.c asks for 1 and waits behind t.b although 1 permit is free, because only the front of the line may take permits. t.a's release lets t.b take 2, then t.c its 1 (Rust Semaphore::acquire(cx, n), all or nothing, FIFO).","unit":"sync","rules":["rule.obligation.reserve","rule.obligation.commit","inv.determinism.replayable"],"seed":42,"lab":{"max_steps":2000},"regions":[{"name":"r.main","parent":"root","budget":null}],"channels":[],"sync":[{"name":"s","type":"semaphore","permits":3}],"tasks":[{"name":"t.a","region":"r.main","budget":null,"program":[{"op":"sem_acquire","semaphore":"s","count":2},{"op":"trace","message":"a holds 2"},{"op":"sleep","ns":100},{"op":"sem_release","semaphore":"s"}]},{"name":"t.b","region":"r.main","budget":null,"program":[{"op":"yield"},{"op":"sem_acquire","semaphore":"s","count":2},{"op":"trace","message":"b holds 2"},{"op":"sem_release","semaphore":"s"}]},{"name":"t.c","region":"r.main","budget":null,"program":[{"op":"yield"},{"op":"yield"},{"op":"sem_acquire","semaphore":"s","count":1},{"op":"trace","message":"c holds 1"},{"op":"sem_release","semaphore":"s"}]}],"script":[],"expect":{"kind":"ok"}}
