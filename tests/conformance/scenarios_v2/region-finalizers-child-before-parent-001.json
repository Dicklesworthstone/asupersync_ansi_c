{
  "schema": "asx.scenario.v2",
  "id": "region-finalizers-child-before-parent-001",
  "description": "Cancelling r.parent cancels its subtree. r.child finalizes first (its task is done, nothing below it): its finalizer runs, then r.child closes and r.parent, whose child regions are done, enters Finalizing and runs its own finalizer. Each finalizer task is spawned by the lab step after the region entered Finalizing (schedule_async_finalizers, lab/runtime.rs:4513).",
  "unit": "region_lifecycle",
  "rules": ["rule.region.close_begin", "rule.region.close_children_done", "rule.region.close_complete", "inv.determinism.replayable"],
  "seed": 42,
  "lab": {"max_steps": 1000},
  "regions": [
    {"name": "r.parent", "parent": "root", "budget": null,
     "finalizers": [{"name": "f.parent", "program": [{"op": "trace", "message": "parent finalizer"}, {"op": "yield"}, {"op": "trace", "message": "parent finalizer end"}]}]},
    {"name": "r.child", "parent": "r.parent", "budget": null,
     "finalizers": [{"name": "f.child", "program": [{"op": "trace", "message": "child finalizer"}, {"op": "yield"}, {"op": "trace", "message": "child finalizer end"}]}]}
  ],
  "channels": [], "sync": [],
  "tasks": [{"name": "t.work", "region": "r.child", "budget": null,
    "program": [{"op": "sleep", "ns": 100}, {"op": "trace", "message": "work done"}]}],
  "script": [{"at_ns": 0, "op": {"op": "cancel_region", "region": "r.parent", "kind": "User"}}],
  "expect": {"kind": "ok"}
}
