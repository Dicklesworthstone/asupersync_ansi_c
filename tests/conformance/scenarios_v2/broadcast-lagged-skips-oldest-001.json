{"schema":"asx.scenario.v2","id":"broadcast-lagged-skips-oldest-001","description":"A capacity-2 broadcast gets five sends before its subscriber reads. The ring keeps only the last two values, so the first recv reports ASX_E_LAGGED with the number of values it missed (3), and the next two recvs return the retained values 4 and 5: a slow receiver is told how much it lost instead of blocking the sender.","unit":"broadcast","rules":["inv.determinism.replayable"],"seed":42,"lab":{"max_steps":500},"regions":[{"name":"r.main","parent":"root","budget":null}],"channels":[{"name":"ch.news","type":"broadcast","capacity":2,"sender":"t.pub","subscribers":["t.slow"]}],"sync":[],"tasks":[{"name":"t.pub","region":"r.main","budget":null,"program":[{"op":"broadcast_send","channel":"ch.news","value":1},{"op":"broadcast_send","channel":"ch.news","value":2},{"op":"broadcast_send","channel":"ch.news","value":3},{"op":"broadcast_send","channel":"ch.news","value":4},{"op":"broadcast_send","channel":"ch.news","value":5}]},{"name":"t.slow","region":"r.main","budget":null,"program":[{"op":"sleep","ns":100},{"op":"broadcast_recv","channel":"ch.news"},{"op":"broadcast_recv","channel":"ch.news"},{"op":"broadcast_recv","channel":"ch.news"}]}],"script":[],"expect":{"kind":"ok"}}
