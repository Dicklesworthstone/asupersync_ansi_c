{"schema":"asx.scenario.v2","id":"sync-barrier-cancelled-waiter-withdraws-arrival-001","description":"A 3-party barrier. t.a and t.b arrive and park; the driver cancels t.a at 50, so its wait ends with ASX_E_CANCELLED and its arrival is withdrawn (finish_cancelled decrements the count, sync/barrier.rs). t.c arrives at 100 and must still wait, because only two live parties are there; t.d arrives at 200 and trips it, releasing t.b, t.c and t.d together. Had the cancelled arrival counted, t.c would have tripped the barrier at 100.","unit":"sync","rules":["rule.cancel.request","rule.cancel.acknowledge","inv.determinism.replayable"],"seed":42,"lab":{"max_steps":1000},"regions":[{"name":"r.main","parent":"root","budget":null}],"channels":[],"sync":[{"name":"b","type":"barrier","parties":3}],"tasks":[{"name":"t.a","region":"r.main","budget":null,"program":[{"op":"barrier_wait","barrier":"b"},{"op":"trace","message":"a passed"}]},{"name":"t.b","region":"r.main","budget":null,"program":[{"op":"barrier_wait","barrier":"b"},{"op":"trace","message":"b passed"}]},{"name":"t.c","region":"r.main","budget":null,"program":[{"op":"sleep","ns":100},{"op":"trace","message":"c arrives"},{"op":"barrier_wait","barrier":"b"},{"op":"trace","message":"c passed"}]},{"name":"t.d","region":"r.main","budget":null,"program":[{"op":"sleep","ns":200},{"op":"trace","message":"d arrives"},{"op":"barrier_wait","barrier":"b"},{"op":"trace","message":"d passed"}]}],"script":[{"at_ns":50,"op":{"op":"cancel_task","task":"t.a","kind":"User"}}],"expect":{"kind":"ok"}}
