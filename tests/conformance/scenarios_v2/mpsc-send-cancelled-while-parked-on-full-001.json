{"schema":"asx.scenario.v2","id":"mpsc-send-cancelled-while-parked-on-full-001","description":"t.p fills a capacity-1 channel and parks on a second send. The driver cancels it at 50: the parked send ends with ASX_E_CANCELLED, its value never enters the queue, and the first value is still delivered when t.r reads at 200, followed by ASX_E_DISCONNECTED once t.p's sender is dropped with the cancelled task.","unit":"mpsc","rules":["rule.cancel.request","rule.cancel.acknowledge","inv.determinism.replayable"],"seed":42,"lab":{"max_steps":1000},"regions":[{"name":"r.main","parent":"root","budget":null}],"channels":[{"name":"ch.q","type":"mpsc","capacity":1,"sender":"t.p","receiver":"t.r"}],"sync":[],"tasks":[{"name":"t.p","region":"r.main","budget":null,"program":[{"op":"send","channel":"ch.q","value":1},{"op":"send","channel":"ch.q","value":2}]},{"name":"t.r","region":"r.main","budget":null,"program":[{"op":"sleep","ns":200},{"op":"recv","channel":"ch.q"},{"op":"recv","channel":"ch.q"}]}],"script":[{"at_ns":50,"op":{"op":"cancel_task","task":"t.p","kind":"User"}}],"expect":{"kind":"ok"}}
