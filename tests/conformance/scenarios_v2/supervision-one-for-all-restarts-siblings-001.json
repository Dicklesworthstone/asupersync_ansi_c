{"schema":"asx.scenario.v2","id":"supervision-one-for-all-restarts-siblings-001","description":"A one_for_all supervisor: a transient child fails, so every running sibling is cancelled, drained and replaced (a temporary one is not); the second failure is refused and stops the child.","unit":"supervision","rules":["rule.ownership.spawn","def.outcome.four_valued","rule.region.close_cancel_children"],"seed":42,"lab":{"max_steps":5000},"regions":[{"name":"r.main","parent":"root","budget":null}],"channels":[],"sync":[],"tasks":[{"name":"t.owner","region":"r.main","budget":null,"program":[{"op":"supervise","as":"sup.a","policy":"one_for_all","max_restarts":1,"window_ns":60000000000,"children":[{"name":"c.a","mode":"permanent","program":[{"op":"sleep","ns":50000000},{"op":"return","outcome":{"tag":"ok"}}]},{"name":"c.b","mode":"transient","program":[{"op":"yield"},{"op":"return","outcome":{"tag":"err","status":"ASX_E_INVALID_STATE"}}]},{"name":"c.c","mode":"temporary","program":[{"op":"sleep","ns":1000000000},{"op":"return","outcome":{"tag":"ok"}}]}]},{"op":"supervisor_join","supervisor":"sup.a"}]}],"script":[],"expect":{"kind":"ok"}}