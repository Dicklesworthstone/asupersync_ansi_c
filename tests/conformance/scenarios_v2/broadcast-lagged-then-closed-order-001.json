{"schema":"asx.scenario.v2","id":"broadcast-lagged-then-closed-order-001","description":"A capacity-2 broadcast gets three sends and then its only sender ends (the channel closes) before the subscriber reads. The subscriber's four recvs show the order Rust reports: ASX_E_LAGGED for the one value it missed, the two retained values, and only then ASX_E_DISCONNECTED once the queue is drained; a closed channel does not discard what is still queued.","unit":"broadcast","rules":["inv.determinism.replayable"],"seed":42,"lab":{"max_steps":500},"regions":[{"name":"r.main","parent":"root","budget":null}],"channels":[{"name":"ch.news","type":"broadcast","capacity":2,"sender":"t.pub","subscribers":["t.slow"]}],"sync":[],"tasks":[{"name":"t.pub","region":"r.main","budget":null,"program":[{"op":"broadcast_send","channel":"ch.news","value":1},{"op":"broadcast_send","channel":"ch.news","value":2},{"op":"broadcast_send","channel":"ch.news","value":3}]},{"name":"t.slow","region":"r.main","budget":null,"program":[{"op":"sleep","ns":100},{"op":"broadcast_recv","channel":"ch.news"},{"op":"broadcast_recv","channel":"ch.news"},{"op":"broadcast_recv","channel":"ch.news"},{"op":"broadcast_recv","channel":"ch.news"}]}],"script":[],"expect":{"kind":"ok"}}
