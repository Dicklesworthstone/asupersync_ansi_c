{
  "schema": "asx.scenario.v2",
  "id": "region-body-ok-parked-001",
  "description": "An Ok body leaves a parked notify waiter alive until its sibling wakes it. Both children finish normally before the region closes; no body cancellation is requested.",
  "unit": "region_lifecycle",
  "rules": ["rule.region.close_begin", "inv.region.quiescence"],
  "seed": 42,
  "lab": {"max_steps": 1000},
  "regions": [{"name": "r.main", "parent": "root", "budget": null}],
  "channels": [], "sync": [{"name": "n", "type": "notify"}],
  "tasks": [{"name": "t.waiter", "region": "r.main", "budget": null,
    "program": [{"op": "notify_wait", "notify": "n"}, {"op": "checkpoint"},
      {"op": "trace", "message": "waiter finished normally"}]},
    {"name": "t.notifier", "region": "r.main", "budget": null,
      "program": [{"op": "sleep", "ns": 100}, {"op": "notify_one", "notify": "n"}]}],
  "script": [{"at_ns": 0, "op": {"op": "finish_region", "region": "r.main", "body": "ok"}}],
  "expect": {"kind": "ok"}
}
