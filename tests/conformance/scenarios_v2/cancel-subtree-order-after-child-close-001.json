{"schema":"asx.scenario.v2","id":"cancel-subtree-order-after-child-close-001","description":"A task opens four child regions, each with a sleeping task, and closes the second; the driver then cancels the parent region. The closed child leaves the parent's child list without reordering the other three, and the cancel reaches their tasks in the order Rust's subtree walk visits them.","unit":"cancel","rules":["rule.cancel.request","inv.cancel.propagates_down","rule.cancel.acknowledge","rule.region.close_complete"],"seed":42,"lab":{"max_steps":4000},"regions":[{"name":"r.main","parent":"root","budget":null}],"channels":[],"sync":[],"tasks":[{"name":"t.owner","region":"r.main","budget":null,"program":[{"op":"open_region","as":"r.w"},{"op":"spawn","as":"t.w","region":"r.w","program":[{"op":"sleep","ns":1000000},{"op":"checkpoint"}]},{"op":"open_region","as":"r.x"},{"op":"spawn","as":"t.x","region":"r.x","program":[{"op":"sleep","ns":1000000},{"op":"checkpoint"}]},{"op":"open_region","as":"r.y"},{"op":"spawn","as":"t.y","region":"r.y","program":[{"op":"sleep","ns":1000000},{"op":"checkpoint"}]},{"op":"open_region","as":"r.z"},{"op":"spawn","as":"t.z","region":"r.z","program":[{"op":"sleep","ns":1000000},{"op":"checkpoint"}]},{"op":"close_region","region":"r.x"},{"op":"sleep","ns":1000000},{"op":"checkpoint"}]}],"script":[{"at_ns":100,"op":{"op":"cancel_region","region":"r.main","kind":"User"}}],"expect":{"kind":"ok"}}
