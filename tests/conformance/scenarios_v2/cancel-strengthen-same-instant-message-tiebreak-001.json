{"schema":"asx.scenario.v2","id":"cancel-strengthen-same-instant-message-tiebreak-001","description":"Two requests of equal severity at the same virtual time (100) differ only in their message, and strengthen then compares the messages: a message replaces none, and the lexicographically smaller replaces the larger. t.a gets Timeout \"b\" then Deadline \"a\" (the second wins: Deadline \"a\"); t.b gets Timeout with no message then Deadline \"z\" (Deadline \"z\"); t.c gets Timeout \"a\" then Deadline \"b\" (the first stays: Timeout \"a\").","unit":"cancel","rules":["rule.cancel.request","inv.cancel.idempotence","def.cancel.reason_ordering"],"seed":42,"lab":{"max_steps":5000},"regions":[{"name":"r.main","parent":"root","budget":null}],"channels":[],"sync":[{"name":"n.never","type":"notify"}],"tasks":[{"name":"t.a","region":"r.main","budget":null,"program":[{"op":"notify_wait","notify":"n.never"}]},{"name":"t.b","region":"r.main","budget":null,"program":[{"op":"notify_wait","notify":"n.never"}]},{"name":"t.c","region":"r.main","budget":null,"program":[{"op":"notify_wait","notify":"n.never"}]}],"script":[{"at_ns":100,"op":{"op":"cancel_task","task":"t.a","kind":"Timeout","message":"b"}},{"at_ns":100,"op":{"op":"cancel_task","task":"t.a","kind":"Deadline","message":"a"}},{"at_ns":100,"op":{"op":"cancel_task","task":"t.b","kind":"Timeout"}},{"at_ns":100,"op":{"op":"cancel_task","task":"t.b","kind":"Deadline","message":"z"}},{"at_ns":100,"op":{"op":"cancel_task","task":"t.c","kind":"Timeout","message":"a"}},{"at_ns":100,"op":{"op":"cancel_task","task":"t.c","kind":"Deadline","message":"b"}}],"expect":{"kind":"ok"}}
